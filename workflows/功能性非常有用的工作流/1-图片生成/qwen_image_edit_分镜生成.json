接文字，不要有空行，一行一个场景，不要有特殊符号，不要废话，直接输出内容,中文描述\nNext Scene: 分镜1描述\nNext Scene: 分镜2描述\nNext Scene: 分镜3描述\nNext Scene: 分镜4描述\nNext Scene: 分镜5描述\nNext Scene: 分镜6描述",1024,false,1,"fixed"],"color":"#28403f","bgcolor":"#374539"},{"id":177,"type":"ImpactStringSelector","pos":[497.37123305743313,-624.2821433956958],"size":[400,200],"flags":{},"order":42,"mode":0,"inputs":[{"localized_name":"strings","name":"strings","type":"STRING","widget":{"name":"strings"},"link":376},{"localized_name":"multiline","name":"multiline","type":"BOOLEAN","widget":{"name":"multiline"},"link":null},{"localized_name":"select","name":"select","type":"INT","widget":{"name":"select"},"link":364}],"outputs":[{"localized_name":"STRING","name":"STRING","type":"STRING","links":[365]}],"properties":{"cnr_id":"comfyui-impact-pack","ver":"8.28.0","Node name for S&R":"ImpactStringSelector"},"widgets_values":["",false,0]},{"id":201,"type":"SetNode","pos":[-236.79918026763218,-693.3872746008205],"size":[210,60],"flags":{},"order":71,"mode":0,"inputs":[{"name":"*","type":"*","link":375}],"outputs":[{"name":"*","type":"*","links":null}],"title":"Set_prompts","properties":{"previousName":"prompts"},"widgets_values":["prompts"]},{"id":204,"type":"GetNode","pos":[-2367.4853236402205,-757.4589202661591],"size":[210,60],"flags":{},"order":9,"mode":0,"inputs":[],"outputs":[{"name":"*","type":"*","links":[377]}],"title":"Get_output_images","properties":{},"widgets_values":["output_images"]},{"id":194,"type":"SetNode","pos":[924.0819448558717,-559.1952422240864],"size":[210,60],"flags":{},"order":56,"mode":0,"inputs":[{"name":"STRING","type":"STRING","link":365}],"outputs":[{"name":"STRING","type":"STRING","links":[378]}],"title":"Set_current_prompt","properties":{"previousName":"current_prompt"},"widgets_values":["current_prompt"]},{"id":198,"type":"GetNode","pos":[960.8911644108367,-713.8651676587624],"size":[210,60],"flags":{},"order":10,"mode":0,"inputs":[],"outputs":[{"name":"IMAGE","type":"IMAGE","links":[370]}],"tit